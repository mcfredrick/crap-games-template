name: Update Game Registry

permissions:
  contents: write

# Manual so a game can deploy to its github.io URL during development and join
# all.crap.games only once its subdomain is live.
on:
  workflow_dispatch:

jobs:
  update-registry:
    uses: mcfredrick/crap_games/.github/workflows/update-registry.yml@main
    with:
      game-name: "{{ game_name }}"
      subdomain: "{{ subdomain }}"
      description: "{{ description }}"
      category: "{{ category }}"
      tags: "{{ tags }}"
      thumbnail-url: "https://{{ subdomain }}.crap.games/index.icon.png"
      author: "{{ author }}"
      repo-url: "{{ repo_url }}"
      version: "{{ version }}"
    secrets: inherit
